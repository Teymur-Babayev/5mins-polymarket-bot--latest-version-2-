# Copy to .env on the VPS (or export vars in systemd). Do not commit .env.

# Listen on all interfaces so remote bots can connect.
BIND_HOST=0.0.0.0
PORT=8787

# MUST match REMOTE_TELEMETRY_BASE_URL in the bot repo (src/services/telemetryClient.ts) — same public IP/DNS as this VPS.
# Example: HOST=151.158.1.13
HOST=127.0.0.1

# Same string on every remote bot .env as TELEMETRY_SECRET. Strongly recommended on the public internet.
# TELEMETRY_SECRET=generate-a-long-random-string

# Refuse to start if TELEMETRY_SECRET is empty (use after you have set the secret everywhere).
# TELEMETRY_REQUIRE_SECRET=1

# TELEMETRY_LOG_PATH=./telemetry-incoming.jsonl
# TELEMETRY_CONSOLE_LOG=1
# TELEMETRY_CONSOLE_LOG=0

# Behind nginx/caddy with X-Forwarded-For:
# TRUST_PROXY=1

# Browser-only WS hardening (Node bots send no Origin - they are always allowed):
# WS_ALLOWED_ORIGINS=https://your-admin-ui.example.com

# CORS for browser tools hitting POST/GET (default *):
# CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# On each BOT machine (home PC, laptop, etc.) - use the *bot* project .env, not this file:
#   REMOTE_TELEMETRY_BASE_URL in bot's telemetryClient.ts = http://<THIS_VPS_HOST>:8787
#   TELEMETRY_SECRET=<same as on VPS if you set one>
#   VERSION=1.0.0
# -----------------------------------------------------------------------------
